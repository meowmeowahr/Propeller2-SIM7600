{Spin2_v53}

'' =================================================================================================
''
''   File....... 07_mqtt_publish_large.spin2
''   Purpose.... MQTT Publisher Client Example for SIM7600 Modem (Streaming Large Payloads)
''   Authors.... Kevin Ahr
''               -- see below for terms of use
''   E-mail..... meowmeowahr@gmail.com
''   Started.... 28 JUN 2026
''   Updated.... 03 JUL 2026
''   WARNING.... This example consumes a lot of data and may incur costs on your cellular plan. Use with caution.
''
'' =================================================================================================

CON

    _CLKFREQ  = 200_000_000

CON { app io pins}

    RX   = 1
    TX   = 0
    DTR  = 2
    RST  = 3
    RTS  = 4                                                        ' connect to modem CTS pin

DAT { network settings }

    APN             BYTE    "hologram",0                            ' Cellular APN
    BROKER_ADDRESS  BYTE    "tcp://emqx.kevinbot.net:1883",0        ' Your MQTT broker address, this example does not support SSL/TLS

    CLIENT_ID       BYTE    "p2_sim7600_client",0                   ' MQTT client id, visible to the broker
    PUBLISH_TOPIC   BYTE    "propeller2/publargedemo",0             ' Topic to publish to
    WILL_TOPIC      BYTE    "p2_sim7600_client/will",0              ' Topic for the will message
    WILL_MSG        BYTE    "offline",0                             ' Will message to be sent if the client disconnects unexpectedly

CON

    MODEM_BAUD       = 115_200                                      ' Modem baud rate, all modules are factory set to 115200, use `02_baud_rate_persist.spin2` to change the rate persistently
    MODEM_RESET      = 1                                            ' Reset modem on startup, 0 = no reset, 1 = reset
    INVERT_RTS       = 1                                            ' Invert the RTS pin (CTS on modem side) so that HIGH allows the module to transmit

    RX_BUFFER_SIZE   = 4096
    URC_BUFFER_SIZE  = 4096
    PAYLOAD_SIZE     = 10240                                        ' 10240 bytes for demo, absolute maximum supported payload by the SIM7600 firmware

OBJ

    modem       : "ka_sim7600"
    secrets     : "00_secrets"
    prng        : "jm_prng"

VAR

    ' large modem buffers
    BYTE    rxBuffer[RX_BUFFER_SIZE]
    BYTE    urcBuffer[URC_BUFFER_SIZE]

PUB main() | status, i, bytesSent, byteVal, charByte, result
    modem.start(RX, TX, RTS, DTR, RST, MODEM_BAUD, MODEM_RESET, INVERT_RTS, @rxBuffer, RX_BUFFER_SIZE, @urcBuffer, URC_BUFFER_SIZE)

    ' leds off
    pinl(56)
    pinl(57)

    ' Wait until modem is ready
    repeat
        waitms(1000)
        debug("Modem starting...")
        if modem.isReady()
            debug("Modem ready!")
            quit

    ' Configure APN
    status := modem.definePdpContext(1, @APN)
    debug("definePdpContext: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to set APN")
        repeat
            waitct(1)

    ' Start MQTT Service
    status := modem.mqttStart()
    debug("mqttStart: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to start MQTT service")
        repeat
            waitct(1)

    ' acquire client 0
    status := modem.mqttAcquireClient(0, @CLIENT_ID)
    debug("mqttAcquireClient: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to acquire client")
        repeat
            waitct(1)

    ' will topic
    status := modem.mqttWillTopic(0, @WILL_TOPIC)
    debug("mqttWillTopic: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to set will topic")
        repeat
            waitct(1)

    ' will msg
    status := modem.mqttWillMsg(0, @WILL_MSG, 1)
    debug("mqttWillMsg: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to set will msg")
        repeat
            waitct(1)

    ' connect
    status := modem.mqttConnect(0, @BROKER_ADDRESS, 60, 1, secrets.mqttUsername(), secrets.mqttPassword())
    debug("mqttConnect: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to connect to broker")
        repeat
            waitct(1)

    i := 0
    repeat
        debug("Starting transmission #", sdec(i))
        
        status := modem.setMqttPublishTopic(0, @PUBLISH_TOPIC)
        if status <> modem.RESULT_OK
            debug("Failed to set topic")
            repeat
                waitct(1)

        ' Start MQTT publish stream
        status := modem.startMqttPayloadStream(0, PAYLOAD_SIZE)
        if status <> modem.RESULT_OK
            debug("startMqttPublishStream failed: ", sdec(status))
            waitms(2000)
            i++
            next

        ' Send the payload data using streaming
        bytesSent := 0
        repeat PAYLOAD_SIZE
            ' Generate a random byte (0-255) and map to 'A'-'Z'
            byteVal := prng.xrandomize(0, 255)
            charByte := ((byteVal // 26) + "A")

            ' Send the byte via stream - retry if buffer full
            repeat
                result := modem.streamTxByte(charByte)
                ' debug("Bytes remaining: ", udec(result))
                if result >= 0
                    bytesSent++
                    quit
                else
                    ' Buffer full - wait and try again
                    waitms(10)

        ' Check if all bytes were sent
        if bytesSent == PAYLOAD_SIZE
            debug("Successfully sent ", sdec(PAYLOAD_SIZE), " bytes via stream")
            modem.mqttPublish(0, 0, 0, 60)
        else
            debug("Only sent ", sdec(bytesSent), " of ", sdec(PAYLOAD_SIZE), " bytes")

        i++
        waitms(5000)

CON { license }

