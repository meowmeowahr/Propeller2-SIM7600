{Spin2_v53}

'' =================================================================================================
''
''   File....... 08_filesystem.spin2
''   Purpose.... Get basic info from SIM7600 Modem
''   Authors.... Kevin Ahr
''               -- see below for terms of use
''   E-mail..... meowmeowahr@gmail.com
''   Started.... 03 JUL 2026
''   Updated.... 03 JUL 2026
''
'' =================================================================================================

CON
    _CLKFREQ  = 200_000_000
    debug_main
    BR_TERM   = 230_400                                             ' terminal baud rate

CON { app io pins }

    RX   = 1
    TX   = 0
    DTR  = 2
    RST  = 3

CON

    MODEM_BAUD             = 115_200                                ' Modem baud rate, all modules are factory set to 115200, use `02_baud_rate_persist.spin2` to change the rate persistently
    MODEM_RESET            = 0                                      ' Reset modem on startup, 0 = no reset, 1 = reset

    RX_BUFFER_SIZE         = 4096
    URC_BUFFER_SIZE        = 1024

    DIRECTORY_BUFFER_SIZE  = 512
    FILE_BUFFER_SIZE       = 512

OBJ

    modem       : "ka_sim7600"
    term        : "jm_fullduplexserial"
    str         : "string"

VAR

    ' large modem buffers
    BYTE    rxBuffer[RX_BUFFER_SIZE]
    BYTE    urcBuffer[URC_BUFFER_SIZE]

    BYTE    cwd[128]
    BYTE    input[128]
    BYTE    returnCode

    BYTE    listFileBuffer[FILE_BUFFER_SIZE]
    BYTE    listDirectoryBuffer[DIRECTORY_BUFFER_SIZE]

PUB main() | pos, c

    modem.start(RX, TX, DTR, RST, MODEM_BAUD, MODEM_RESET, @rxBuffer, RX_BUFFER_SIZE, @urcBuffer, URC_BUFFER_SIZE)
    term.tstart(BR_TERM)

    ' wait for terminal input
    term.rxflush()
    term.RX()

    term.str(@"Modem starting")
    ' Wait until modem is ready
    repeat
        term.TX(".")
        if modem.isReady()
            term.TX(10)
            term.TX(13)
            term.str(@"Modem ready")
            term.TX(10)
            term.TX(13)
            quit
        waitms(1000)

    modem.fsPwd(@cwd, 128)
    term.TX("[")
    term.dec(returnCode)
    term.TX("]")
    term.TX(" ")
    term.str(@cwd)
    term.str(@"> ")
    repeat
        c := term.rxcheck()
        case c
            -1, 0, term.LF:
                next
            term.CR:
                input[pos] := 0
                term.TX(10)
                term.TX(13)
                returnCode := processCommand(@input)
                pos := 0
                modem.fsPwd(@cwd, 128)
                term.TX("[")
                term.dec(returnCode)
                term.TX("]")
                term.TX(" ")
                term.str(@cwd)
                term.str(@"> ")
            127:
                if pos > 0
                    pos -= 1
                    term.TX(term.BKSP)
                    term.TX(32)
                    term.TX(term.BKSP)
            other:
                input[pos] := c
                pos += 1
                term.TX(c)


PUB processCommand(p_input) : r | ct
    if str.startswith(p_input, @"cd ")
        r := modem.fsCd(p_input + 3)
    elseif str.startswith(p_input, @"mkdir ")
        r := modem.fsMkdir(p_input + 6)
    elseif str.startswith(p_input, @"rmdir ")
        r := modem.fsRmdir(p_input + 6)
    elseif str.startswith(p_input, @"rm ")
        r := modem.fsDel(p_input + 3)
    elseif str.startswith(p_input, @"rename ")
        r := doRename(p_input + 7)
    elseif strcomp(p_input, @"fc")
        ct := modem.fsFileCount()
        if ct == -1
            return 1
        term.dec(ct)
        term.str(@" files")
        term.TX(10)
        term.TX(13)
        return 0
    elseif strcomp(p_input, @"sdc")
        ct := modem.fsSubdirectoryCount()
        if ct == -1
            return 1
        term.dec(ct)
        term.str(@" directories")
        term.TX(10)
        term.TX(13)
        return 0
    elseif strcomp(p_input, @"ls")
        bytefill(@listDirectoryBuffer, 0, DIRECTORY_BUFFER_SIZE)
        bytefill(@listFileBuffer, 0, FILE_BUFFER_SIZE)
        r := modem.fsLs(@listFileBuffer, @listDirectoryBuffer, 512, 512)
        if r <> modem.RESULT_OK
            return r
        printEntryList("d", @listDirectoryBuffer)
        printEntryList("f", @listFileBuffer)
        return 0
    elseif str.isempty(p_input)
        r := returnCode
    else
        r := 2

PRI doRename(pArgs) : r | addr
'' pArgs points at "<from> <to>" (the part after "mv "). Split on the first
'' space, then call fsRename(from, to).

    addr := pArgs
    repeat while (BYTE[addr] <> " ") and (BYTE[addr] <> 0)
        addr++

    if BYTE[addr] <> " "
        return 2                            ' malformed - no second argument

    BYTE[addr] := 0                          ' terminate "from" in place
    addr++                                    ' skip the space

    repeat while (BYTE[addr] == " ")         ' tolerate extra spaces before "to"
        addr++

    if BYTE[addr] == 0
        return 2                            ' malformed - "to" missing/empty

    r := modem.fsRename(pArgs, addr)

PRI printEntryList(type, pBuf) | addr
'' Walk a 255-separated, 0-terminated list of entries, printing one per line

    addr := pBuf
    repeat while (BYTE[addr] <> 0)
        term.TX(type)
        term.TX(" ")
        repeat while (BYTE[addr] <> 255) AND (BYTE[addr] <> 0)
            term.TX(BYTE[addr])
            addr++
        term.TX(10)
        term.TX(13)
        if BYTE[addr] == 255
            addr++

CON { license }

