{Spin2_v53}

'' =================================================================================================
''
''   File....... 08_filesystem.spin2
''   Purpose.... Get basic info from SIM7600 Modem
''   Authors.... Kevin Ahr
''               -- see below for terms of use
''   E-mail..... meowmeowahr@gmail.com
''   Started.... 03 JUL 2026
''   Updated.... 05 JUL 2026
''
'' =================================================================================================

CON
    _CLKFREQ  = 300_000_000

    BR_TERM   = 921_600                                             ' terminal baud rate

CON { app io pins }

    RX   = 1
    TX   = 0
    DTR  = 2
    RST  = 3
    RTS  = 4                                                        ' connect to modem CTS pin
    CTS  = 5                                                        ' connect to modem RTS pin

CON

    MODEM_BAUD             = 115_200                                ' Modem baud rate, all modules are factory set to 115200, use `02_baud_rate_persist.spin2` to change the rate persistently
    MODEM_RESET            = 0                                      ' Reset modem on startup, 0 = no reset, 1 = reset
    SERIAL_MODE            = %11000
'' -- mode....       %0xx1 = invert rx
''                   %0x1x = invert tx
''                   %01xx = open-drain/open-source tx
''                   %1xxx = invert rts (idle/deasserted = low, asserted = high)
''                  %1xxxx = invert cts (peer asserts with high instead of low)

    RX_BUFFER_SIZE         = 4096
    URC_BUFFER_SIZE        = 1024

    DIRECTORY_BUFFER_SIZE  = 512
    FILE_BUFFER_SIZE       = 512

OBJ

    modem       : "ka_sim7600"
    term        : "jm_fullduplexserial"
    str         : "string"
    ansi        : "jm_ansi"

DAT

    Banner      BYTE    "=======================================================",10,13
                BYTE    " P2 SIM7600 Filesystem Demo                            ",10,13
                BYTE    " Commands:                                             ",10,13
                BYTE    " ls                  - list files and directories      ",10,13
                BYTE    " mem                 - show available storage          ",10,13
                BYTE    " sdc                 - get number of subdirectories    ",10,13
                BYTE    " fc                  - get number of files             ",10,13
                BYTE    " info <abspath>      - show file size and creation date",10,13
                BYTE    " cd <path>           - change dir, supports `..`       ",10,13
                BYTE    " mkdir <name>        - create dir, no recursion        ",10,13
                BYTE    " rmdir <name>        - remove dir, no recursion        ",10,13
                BYTE    " rename <from> <to>  - rename file or directory        ",10,13
                BYTE    " cp <from> <to>      - copy file                       ",10,13
                BYTE    " rm <name>           - delete file                     ",10,13
                BYTE    " rx <abspath>        - dump contents of a file         ",10,13
                BYTE    " tx <abspath> <size> - create and send a file of <size>",10,13
                BYTE    "=======================================================",10,13,0

VAR

    ' large modem buffers
    BYTE    rxBuffer[RX_BUFFER_SIZE]
    BYTE    urcBuffer[URC_BUFFER_SIZE]

    BYTE    cwd[128]
    BYTE    input[128]
    BYTE    returnCode
    BYTE    txUploadActive
    BYTE    txUploadWaitingOk
    LONG    txUploadExpected
    LONG    txUploadSent

    BYTE    listFileBuffer[FILE_BUFFER_SIZE]
    BYTE    listDirectoryBuffer[DIRECTORY_BUFFER_SIZE]

PUB main() | pos, c, r, b

    modem.start(RX, TX, RTS, CTS, DTR, RST, MODEM_BAUD, MODEM_RESET, SERIAL_MODE, @rxBuffer, RX_BUFFER_SIZE, @urcBuffer, URC_BUFFER_SIZE)
    term.tstart(BR_TERM)

    ' wait for terminal input
    term.rxflush()
    term.RX()

    term.str(@Banner)

    term.str(@"Modem starting")
    ' Wait until modem is ready
    repeat
        term.TX(".")
        if modem.isReady()
            term.str(string(10, 13, "Modem ready", 10, 13))
            quit
        waitms(1000)

    txUploadActive := 0
    txUploadWaitingOk := 0
    txUploadExpected := 0
    txUploadSent := 0

    txPrompt(@cwd, returnCode)
    repeat
        if txUploadWaitingOk
            ifnot modem.isCommandRunning()
                txUploadWaitingOk := 0
            else
                c := term.rxcheck()
                next

        c := term.rxcheck()
        if txUploadActive
            case c
                -1:
                    next
                other:
                    term.TX(c)
                    sendTxByte(c)
                    if txUploadSent >= txUploadExpected
                        txUploadActive := 0
                        txUploadWaitingOk := 1
                        term.TX(10)
                        term.TX(13)
                        txPromptCached(@cwd, returnCode)
            next

        case c
            -1, 0, term.LF:
                next
            term.CR:
                input[pos] := 0
                term.TX(10)
                term.TX(13)
                returnCode := processCommand(@input)
                pos := 0
                if txUploadActive
                    txDataPrompt()
                else
                    txPrompt(@cwd, returnCode)
            127:                                        ' DEL
                if pos > 0
                    pos -= 1
                    term.TX(term.BKSP)
                    term.TX(32)
                    term.TX(term.BKSP)
            other:
                input[pos] := c
                pos += 1
                term.TX(c)


PUB txPrompt(p_cwd, rc)
    modem.fsPwd(@cwd, 128)
    txPromptCached(p_cwd, rc)


PUB txPromptCached(p_cwd, rc)
    term.str(ansi.fgnd(ansi.MAGENTA))
    term.TX("[")
    term.dec(rc)
    term.TX("]")
    term.str(ansi.normal())
    term.TX(" ")
    term.str(p_cwd)
    term.str(ansi.fgnd(ansi.GREEN))
    term.str(@"> ")
    term.str(ansi.normal())


PUB txDataPrompt()
    term.str(ansi.fgnd(ansi.CYAN))
    term.str(@">>> ")
    term.str(ansi.normal())


PUB processCommand(p_input) : r | ct, modem.fileAttrs attrs, modem.memory mem, b
    if str.startswith(p_input, @"cd ")
        r := modem.fsCd(p_input + 3)
    elseif str.startswith(p_input, @"mkdir ")
        r := modem.fsMkdir(p_input + 6)
    elseif str.startswith(p_input, @"rmdir ")
        r := modem.fsRmdir(p_input + 6)
    elseif str.startswith(p_input, @"rm ")
        r := modem.fsDel(p_input + 3)
    elseif str.startswith(p_input, @"rename ")
        r := doRename(p_input + 7)
    elseif str.startswith(p_input, @"cp ")
        r := doCopy(p_input + 3)
    elseif str.startswith(p_input, @"rx ")
        r := modem.fsStartReceivingFile(p_input + 3)
        if r <> modem.RESULT_OK
            return r
        repeat
            b := modem.streamRxByte()
            if b <> -1
                term.TX(b)
            ' waitms(10) ' simulate (terrible) delay
            elseif modem.streamRxComplete()
                quit
        term.TX(10)
        term.TX(13)
        return 0
    elseif str.startswith(p_input, @"tx ")
        r := doTxUpload(p_input + 3)
        if r <> modem.RESULT_OK
            return r
        return 0

    elseif str.startswith(p_input, @"info ")
        modem.fsGetAttrs(p_input + 5, @attrs)
        term.str(@"Size: ")
        term.dec(attrs.sz)
        term.str(string(" bytes",10,13,"Date: "))
        term.dec(attrs.creation.month)
        term.TX("/")
        term.dec(attrs.creation.day)
        term.TX("/")
        term.dec(attrs.creation.year)
        term.TX(" ")
        term.dec(attrs.creation.hour)
        term.TX(":")
        term.dec(attrs.creation.min)
        term.TX(":")
        term.dec(attrs.creation.sec)
        term.TX(" ")
        term.str(attrs.creation.weekday)
        term.TX(10)
        term.TX(13)
    elseif strcomp(p_input, @"mem")
        r := modem.fsMem(@mem)
        term.fstr3(@"Drive: %c\r\nTotal: %d\r\nUsed: %d\r\n", mem.drive, mem.total, mem.used)
    elseif strcomp(p_input, @"fc")
        ct := modem.fsFileCount()
        if ct == -1
            return 1
        term.dec(ct)
        term.str(@" files")
        term.TX(10)
        term.TX(13)
        return 0
    elseif strcomp(p_input, @"sdc")
        ct := modem.fsSubdirectoryCount()
        if ct == -1
            return 1
        term.dec(ct)
        term.str(@" directories")
        term.TX(10)
        term.TX(13)
        return 0
    elseif strcomp(p_input, @"ls")
        bytefill(@listDirectoryBuffer, 0, DIRECTORY_BUFFER_SIZE)
        bytefill(@listFileBuffer, 0, FILE_BUFFER_SIZE)
        r := modem.fsLs(@listFileBuffer, @listDirectoryBuffer, 512, 512)
        if r <> modem.RESULT_OK
            return r
        printEntryList("d", @listDirectoryBuffer)
        printEntryList("f", @listFileBuffer)
        return 0
    elseif str.isempty(p_input)
        r := returnCode
    else
        r := 2


PRI doTxUpload(pArgs) : r | addr, txLen
'' pArgs points at "<path> <len>". Split once, start CFTRANRX, and enter data mode.

    addr := pArgs
    repeat while (BYTE[addr] <> " ") AND (BYTE[addr] <> 0)
        addr++

    if BYTE[addr] <> " "
        return 2                                        ' malformed - no length argument

    BYTE[addr] := 0                                     ' terminate path in place
    addr++

    repeat while BYTE[addr] == " "                      ' tolerate extra spaces before length
        addr++

    if BYTE[addr] == 0
        return 2                                        ' malformed - length missing

    txLen := str.atoi(addr)
    if txLen <= 0
        return 2

    r := modem.fsStartSendingFile(pArgs, txLen)
    if r <> modem.RESULT_OK
        return r

    txUploadActive := 1
    txUploadWaitingOk := 0
    txUploadExpected := txLen
    txUploadSent := 0
    return 0


PRI sendTxByte(byteValue) : remaining
'' Send one byte to the modem file upload stream, waiting until the modem accepts it.

    repeat
        remaining := modem.streamTxByte(byteValue)
        if remaining >= 0
            txUploadSent++
            return


PRI doRename(pArgs) : r | addr
'' pArgs points at "<from> <to>". Split on the first space, then call fsRename(from, to).

    addr := pArgs
    repeat while (BYTE[addr] <> " ") AND (BYTE[addr] <> 0)
        addr++

    if BYTE[addr] <> " "
        return 2                                        ' malformed - no second argument

    BYTE[addr] := 0                                     ' terminate "from" in place
    addr++                                              ' skip the space

    repeat while (BYTE[addr] == " ")                    ' tolerate extra spaces before "to"
        addr++

    if BYTE[addr] == 0
        return 2                                        ' malformed - "to" missing/empty

    r := modem.fsRename(pArgs, addr)

PRI doCopy(pArgs) : r | addr
'' pArgs points at "<from> <to>". Split on the first space, then call fsCopySync(from, to).

    addr := pArgs
    repeat while (BYTE[addr] <> " ") AND (BYTE[addr] <> 0)
        addr++

    if BYTE[addr] <> " "
        return 2                                        ' malformed - no second argument

    BYTE[addr] := 0                                     ' terminate "from" in place
    addr++                                              ' skip the space

    repeat while (BYTE[addr] == " ")                    ' tolerate extra spaces before "to"
        addr++

    if BYTE[addr] == 0
        return 2                                        ' malformed - "to" missing/empty

    r := modem.fsCopySync(pArgs, addr)

PRI printEntryList(type, pBuf) | addr
'' Walk a 255-separated, 0-terminated list of entries, printing one per line

    addr := pBuf
    repeat while (BYTE[addr] <> 0)
        term.TX(type)
        term.TX(" ")
        repeat while (BYTE[addr] <> 255) AND (BYTE[addr] <> 0)
            term.TX(BYTE[addr])
            addr++
        term.TX(10)
        term.TX(13)
        if BYTE[addr] == 255
            addr++

CON { license }

