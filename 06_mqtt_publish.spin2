{Spin2_v53}

'' =================================================================================================
''
''   File....... 06_mqtt_publish.spin2
''   Purpose.... MQTT Publisher Client Example for SIM7600 Modem
''   Authors.... Kevin Ahr
''               -- see below for terms of use
''   E-mail..... meowmeowahr@gmail.com
''   Started.... 28 JUN 2026
''   Updated.... 03 JUL 2026
''
'' =================================================================================================

CON

    _CLKFREQ  = 200_000_000

CON { app io pins }

    RX   = 1
    TX   = 0
    DTR  = 2
    RST  = 3
    RTS  = 4                                                        ' connect to modem CTS pin

DAT { network settings }

    APN             BYTE    "hologram",0                            ' Cellular APN
    BROKER_ADDRESS  BYTE    "tcp://emqx.kevinbot.net:1883",0        ' Your MQTT broker address, this example does not support SSL/TLS

    CLIENT_ID       BYTE    "p2_sim7600_client",0                   ' MQTT client id, visible to the broker
    PUBLISH_TOPIC   BYTE    "propeller2/pubdemo",0                  ' Topic to publish to

    WILL_TOPIC      BYTE    "p2_sim7600_client/will",0              ' Topic for the will message
    WILL_MSG        BYTE    "offline",0                             ' Will message to be sent if the client disconnects unexpectedly

CON

    INVERT_RTS       = 1                                            ' Invert the RTS pin (CTS on modem side) so that HIGH allows the module to transmit

    RX_BUFFER_SIZE   = 4096
    URC_BUFFER_SIZE  = 4096

OBJ

    modem       : "ka_sim7600"
    secrets     : "00_secrets"
    nstr        : "jm_nstr"

VAR

    ' large modem buffers
    BYTE    rxBuffer[RX_BUFFER_SIZE]
    BYTE    urcBuffer[URC_BUFFER_SIZE]

PUB main() | status, i
    modem.start(RX, TX, RTS, DTR, RST, 115_200, 1, INVERT_RTS, @rxBuffer, RX_BUFFER_SIZE, @urcBuffer, URC_BUFFER_SIZE)

    ' leds off
    pinl(56)
    pinl(57)

    ' Wait until modem is ready
    repeat
        waitms(1000)
        debug("Modem starting...")
        if modem.isReady()
            debug("Modem ready!")
            quit

    ' Configure APN
    status := modem.definePdpContext(1, @APN)
    debug("definePdpContext: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to set APN")
        repeat
            waitct(1)

    ' Start MQTT Service
    status := modem.mqttStart()
    debug("mqttStart: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to start MQTT service")
        repeat
            waitct(1)

    ' acquire client 0
    status := modem.mqttAcquireClient(0, @CLIENT_ID)
    debug("mqttAcquireClient: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to acquire client")
        repeat
            waitct(1)

    ' will topic
    status := modem.mqttWillTopic(0, @WILL_TOPIC)
    debug("mqttWillTopic: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to set will topic")
        repeat
            waitct(1)

    ' will msg
    status := modem.mqttWillMsg(0, @WILL_MSG, 1)
    debug("mqttWillMsg: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to set will msg")
        repeat
            waitct(1)

    ' connect
    ' REPLACE THE MQTT ADDRESS WITH YOUR OWN SERVER
    status := modem.mqttConnect(0, @BROKER_ADDRESS, 60, 1, secrets.mqttUsername(), secrets.mqttPassword())
    debug("mqttConnect: ", sdec(status))
    if status <> modem.RESULT_OK
        debug("Failed to connect to broker")
        repeat
            waitct(1)

    i := 0
    repeat
        ' publish
        status := modem.mqttPublish(0, @PUBLISH_TOPIC, 0, 0, 60, nstr.dec(i, 0))
        debug("mqttPublish: ", sdec(status))
        if status <> modem.RESULT_OK
            debug("Failed to publish to topic")
            repeat
                waitct(1)
        i++
        waitms(2000)

CON { license }

